# The smallest working CucumberSwift setup in Bazel: one test target that runs the feature
# files in Tests/Features, on macOS and on an iOS simulator. Run Bazel from this folder.
module(name = "bazel_module_sample")

bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_apple", version = "5.2.0")
bazel_dep(name = "rules_swift", version = "4.1.2")

# CucumberSwift, and CucumberSwiftExpressions, which it depends on, from their release tags.
bazel_dep(name = "cucumberswift", version = "6.4.0")
git_override(module_name = "cucumberswift", remote = "https://github.com/cucumberswift/CucumberSwift.git", tag = "6.4.0")
bazel_dep(name = "cucumberswift_expressions", version = "1.4.1")
git_override(module_name = "cucumberswift_expressions", remote = "https://github.com/cucumberswift/CucumberSwiftExpressions.git", tag = "1.4.1")
